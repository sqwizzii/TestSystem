@page
@model TestSystem.Views.Teacher.AddAnswerModel
@{

<h2>Додати відповідь</h2>

<form asp-action="AddAnswer" method="post">
    <input type="hidden" asp-for="QuestionId" />

    <div>
        <label asp-for="Text"></label>
        <input asp-for="Text" />
    </div>

    <div>
        <label asp-for="IsCorrect">Правильна відповідь</label>
        <input asp-for="IsCorrect" type="checkbox" />
    </div>

    <button type="submit">Зберегти</button>
</form>

}
