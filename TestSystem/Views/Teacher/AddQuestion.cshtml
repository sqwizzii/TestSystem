@model TestSystem.Entities.Question

@{
    ViewData["Title"] = "Додавання запитання";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}


<h2>Додати питання</h2>

<form asp-action="AddQuestion" method="post">
    <div class="form-group">
        <label asp-for="Text"></label>
        <input asp-for="Text" class="form-control" />
    </div>

    <div class="form-group">
        <label>Оберіть тест</label>
        <select asp-for="TestId" class="form-control" asp-items="ViewBag.Tests"></select>
    </div>

    <button type="submit" class="btn btn-primary">Додати</button>
</form>