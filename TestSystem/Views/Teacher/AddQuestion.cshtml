@model TestSystem.Models.AddQuestionViewModel

<h2>Додати питання до тесту</h2>

<form asp-action="AddQuestion" method="post">
    <input type="hidden" asp-for="TestId" />

    <div class="mb-3">
        <label asp-for="Text" class="form-label">Текст питання</label>
        <input asp-for="Text" class="form-control" />
    </div>

    <h4>Варіанти відповідей</h4>

    @for (int i = 0; i < 4; i++)
    {
        <div class="mb-2">
            <input type="text" name="Answers[@i].Text" class="form-control" placeholder="Відповідь @(i + 1)" />
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="Answers[@i].IsCorrect" />
                <label class="form-check-label">Правильна</label>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-success">Зберегти</button>
</form>
